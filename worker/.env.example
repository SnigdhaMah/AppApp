# Copy this file to .env and set your API key (do not commit .env).
# Used by run_local.py and run_local_complex.py.

# OpenAI (recommended for local runs)
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: use a different model (default is gpt-4o-mini)
# OPENAI_MODEL=gpt-4o

# Alternative: Gemini
# GEMINI_API_KEY=your-gemini-key

# Alternative: Codex CLI (requires Codex installed)
# USE_CODEX=1
